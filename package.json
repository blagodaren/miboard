{
  "name": "miboard",
  "version": "0.1.0-alpha",
  "description": "A lightweight, self-hosted dashboard for mihomo",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/licenses.mjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test scripts/analysis.test.ts scripts/overview.test.ts scripts/rules-analytics.test.ts scripts/test-backends.mjs scripts/test-proxy-sort.ts scripts/test-proxy-batch.ts scripts/test-proxy-icon.ts scripts/test-latency.ts scripts/test-traffic-history.ts scripts/test-geography.mjs scripts/test-geodb.mjs scripts/test-geo-resolver.mjs scripts/test-release.mjs",
    "test:ui": "npm run build && node scripts/test-i18n.mjs && node scripts/test-rules.mjs && node scripts/test-latency-ui.mjs",
    "test:theme": "node scripts/check-theme.mjs",
    "test:backends": "node --test scripts/test-backends.mjs",
    "test:proxy-sort": "node --test scripts/test-proxy-sort.ts",
    "test:proxy-actions": "node --test scripts/test-proxy-batch.ts scripts/test-proxy-icon.ts",
    "test:latency": "node --test scripts/test-latency.ts",
    "test:latency:ui": "npm run build && node scripts/test-latency-ui.mjs",
    "test:analysis": "node --test scripts/analysis.test.ts",
    "test:overview": "node --test scripts/overview.test.ts scripts/test-traffic-history.ts",
    "test:overview:ui": "node scripts/test-overview.mjs",
    "test:geography": "node --test scripts/test-geography.mjs scripts/test-geodb.mjs scripts/test-geo-resolver.mjs",
    "test:geography:ui": "node scripts/check-geography.mjs",
    "generate:map": "node scripts/generate-earth-map.mjs",
    "update:geodb": "node scripts/update-geodb.mjs",
    "test:i18n": "npm run build && node scripts/test-i18n.mjs",
    "test:rules": "npm run build && node scripts/test-rules.mjs",
    "test:rules:analytics": "node --test scripts/rules-analytics.test.ts",
    "mock": "node mock/server.js",
    "zip": "node scripts/zip.js",
    "check:release": "node scripts/check-release.mjs",
    "release": "npm run check && npm test && npm run build && npm run zip && npm run check:release"
  },
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "d3-geo": "^3.1.2",
    "playwright": "^1.63.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "ws": "^8.22.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.70.0",
    "bits-ui": "^2.20.6",
    "uplot": "^1.6.32"
  },
  "private": true,
  "type": "module"
}
